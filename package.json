{
	"name": "eclipse-2026",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"corridor": "tsx scripts/build-corridor.ts",
		"prebuild": "npm run corridor",
		"build": "vite build",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"check": "npm run check:format && npm run check:ts && npm run lint && npm run check:svelte && npm run test",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ts": "tsc --noEmit",
		"check:format": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:report": "playwright show-report",
		"upgrade": "ncu -u --target minor && npm install",
		"upgrade:check": "ncu"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/geojson": "^7946.0.16",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"npm-check-updates": "^22.2.9",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"@versatiles/style": "^5.13.0",
		"astronomy-engine": "^2.1.19",
		"maplibre-gl": "^6.0.0",
		"open-props": "^1.7.23"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true
	}
}
