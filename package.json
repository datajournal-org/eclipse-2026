{
	"name": "eclipse-2026",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:https": "DEV_HTTPS=1 vite dev",
		"cert": "./scripts/dev-cert.sh",
		"prebuild": "npm run precompute",
		"build": "vite build && tsx scripts/inject-maplibre-preload.ts",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"precheck": "npm run precompute",
		"check": "npm run check:format && npm run check:ts && npm run lint && npm run check:svelte && npm run test",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ts": "tsc --noEmit",
		"check:format": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "TZ=Europe/Berlin vitest run",
		"test:unit:watch": "TZ=Europe/Berlin vitest",
		"test:unit:cov": "TZ=Europe/Berlin vitest run --coverage",
		"test:e2e": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:report": "playwright show-report",
		"upgrade": "ncu -u --target minor && npm install",
		"upgrade:check": "ncu",
		"precompute": "svelte-kit sync && tsx scripts/build-corridor.ts && tsx scripts/build-sky.ts && tsx scripts/build-timezones.ts",
		"og:image": "tsx scripts/build-og-image.ts",
		"release": "./scripts/release.sh"
	},
	"overrides": {
		"cookie":"^0.7.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.2",
		"@vitest/coverage-v8": "^5.0.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"npm-check-updates": "^23.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@versatiles/style": "^6.0.1",
		"astronomy-engine": "^2.1.19",
		"maplibre-gl": "^6.11.2",
		"open-props": "^1.7.23"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true
	}
}
