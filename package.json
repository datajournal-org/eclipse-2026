{
	"name": "eclipse-2026",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"corridor": "tsx scripts/build-corridor.ts",
		"prebuild": "npm run corridor",
		"build": "vite build",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"check": "npm run check:format && npm run check:ts && npm run lint && npm run check:svelte && npm run test",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ts": "tsc --noEmit",
		"check:format": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:report": "playwright show-report"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.8.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/geojson": "^7946.0.16",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.15.0",
		"svelte-check": "^4.7.3",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@versatiles/style": "^5.13.0",
		"astronomy-engine": "^2.1.19",
		"maplibre-gl": "^5.0.0",
		"open-props": "^1.7.23"
	}
}
