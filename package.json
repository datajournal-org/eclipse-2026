{
	"name": "eclipse-2026",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:https": "DEV_HTTPS=1 vite dev",
		"cert": "./scripts/dev-cert.sh",
		"prebuild": "npm run precompute",
		"build": "vite build && tsx scripts/inject-maplibre-preload.ts",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"precheck": "npm run precompute",
		"check": "npm run check:format && npm run check:ts && npm run lint && npm run check:svelte && npm run test",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ts": "tsc --noEmit",
		"check:format": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "TZ=Europe/Berlin vitest run",
		"test:unit:watch": "TZ=Europe/Berlin vitest",
		"test:unit:cov": "TZ=Europe/Berlin vitest run --coverage",
		"test:e2e": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:report": "playwright show-report",
		"upgrade": "ncu -u --target minor && npm install",
		"upgrade:check": "ncu",
		"precompute": "svelte-kit sync && tsx scripts/build-corridor.ts && tsx scripts/build-sky.ts",
		"og:image": "tsx scripts/build-og-image.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"jsdom": "^30.0.1",
		"npm-check-updates": "^23.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@versatiles/style": "^5.13.0",
		"astronomy-engine": "^2.1.19",
		"maplibre-gl": "^6.1.0",
		"open-props": "^1.7.23"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true
	}
}
